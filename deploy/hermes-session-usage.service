[Unit]
Description=Hermes Session Usage Dashboard
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/hermes-session-usage
ExecStart=%h/.local/share/hermes-session-usage/HermesSessionMetrics.Web
Environment=ASPNETCORE_URLS=http://127.0.0.1:5187
Environment=DOTNET_ENVIRONMENT=Production
Restart=on-failure
RestartSec=3
LimitNOFILE=65536:524288
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=%h/.hermes

[Install]
WantedBy=default.target
